{
  "name": "@krische/price-tracker",
  "version": "2.0.0",
  "description": "Price drop tracker for Amazon and Best Buy with email alerts",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "release": "semantic-release",
    "scrape": "node src/scraper.js",
    "lint": "eslint .",
    "test": "node --test"
  },
  "dependencies": {
    "@ghostery/adblocker-playwright": "^2.20.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.0",
    "playwright": "^1.64.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "allowScripts": {
    "better-sqlite3": true
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
