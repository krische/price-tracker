# Auth Configuration
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# Optional Gmail notifications
# EMAIL_USER=your_gmail@gmail.com
# EMAIL_PASS=your_app_password_here
# ALERT_EMAIL=alerts@youremail.com

# Optional Pushover notifications
# Create an application/API token at https://pushover.net/apps/build
# PUSHOVER_API_TOKEN=your_application_api_token
# PUSHOVER_USER_KEY=your_user_or_group_key

# Price check cron expression (default: every six hours)
CHECK_INTERVAL_EXPRESSION="0 */6 * * *"

# Price check interval jitter in seconds to randomize the check time (default: 0)
CHECK_INTERVAL_JITTER=0

# Price drop threshold percentage to trigger alert (default: 5)
PRICE_DROP_THRESHOLD=5

# Server port
PORT=3000

# SQLite database file path (default: prices.db in the project root)
# Relative paths are resolved from the current working directory.
DB_PATH=./prices.db
