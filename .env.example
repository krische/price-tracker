# Email Configuration (Gmail recommended)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_app_password_here

# Alert recipient
ALERT_EMAIL=alerts@youremail.com

# Price check interval in minutes (default: -1, which means random interval between 1 and 60 minutes)
CHECK_INTERVAL_MINUTES=-1

# Price check interval in hours (default: 6, less than 1 means every hour)
CHECK_INTERVAL_HOURS=6

# Price drop threshold percentage to trigger alert (default: 5)
PRICE_DROP_THRESHOLD=5

# Server port
PORT=3000

# SQLite database file path (default: prices.db in the project root)
# Relative paths are resolved from the current working directory.
DB_PATH=./prices.db
